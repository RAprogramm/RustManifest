{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config",
  "description": "User-supplied configuration from `rustmanifest.toml`.",
  "type": "object",
  "properties": {
    "exclude": {
      "description": "Glob patterns of files to exclude.",
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "include": {
      "description": "Glob patterns of files to analyze.",
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "invariants": {
      "description": "User-declared behavioral invariants enforced over extracted facts.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Invariant"
      }
    },
    "overrides": {
      "description": "Per-rule severity overrides.",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/RuleOverride"
      }
    },
    "profile": {
      "description": "Profile to apply (`strict`, `default`, `minimal`, `ci`).",
      "type": [
        "string",
        "null"
      ],
      "default": null
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Invariant": {
      "description": "One user-declared behavioral invariant.\n\nExactly one subject is expected per entry: `field` (with\n`write-only-from`) constrains who may write a field; `effect` (with\n`deny-in`) bans a side-effect category from parts of the module tree.\nModule lists hold module-path prefixes (`crate::ledger` covers\n`crate::ledger::posting`).",
      "type": "object",
      "properties": {
        "call-deny-from": {
          "description": "Module-path prefix whose functions must not call into\n`call_deny_to`, directly or through callees.",
          "type": [
            "string",
            "null"
          ]
        },
        "call-deny-to": {
          "description": "Module-path prefix that `call_deny_from` must not reach.",
          "type": [
            "string",
            "null"
          ]
        },
        "deny-in": {
          "description": "Module-path prefixes where `effect` is denied.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "effect": {
          "description": "Side-effect category to ban (`unsafe`, `fs`, `net`, `process`,\n`env`, `console`).",
          "type": [
            "string",
            "null"
          ]
        },
        "field": {
          "description": "Field whose writers are constrained, as `Owner.field`.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "Identifier used as the finding's rule id; positional `RM-INV-NNN`\nwhen absent.",
          "type": [
            "string",
            "null"
          ]
        },
        "severity": {
          "description": "Severity of violations; `error` when absent.",
          "anyOf": [
            {
              "$ref": "#/$defs/Severity"
            },
            {
              "type": "null"
            }
          ]
        },
        "write-only-from": {
          "description": "Module-path prefixes allowed to write `field`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "RuleOverride": {
      "description": "Per-rule severity override entry.",
      "type": "object",
      "properties": {
        "rule-id": {
          "description": "Rule identifier to override.",
          "type": "string"
        },
        "severity": {
          "description": "New severity for the rule.",
          "$ref": "#/$defs/Severity"
        }
      },
      "additionalProperties": false,
      "required": [
        "rule-id",
        "severity"
      ]
    },
    "Severity": {
      "description": "Severity of a rule or a finding.",
      "oneOf": [
        {
          "description": "Blocking — fails CI.",
          "type": "string",
          "const": "error"
        },
        {
          "description": "Non-blocking concern that should be addressed.",
          "type": "string",
          "const": "warning"
        },
        {
          "description": "Informational.",
          "type": "string",
          "const": "info"
        },
        {
          "description": "Style hint.",
          "type": "string",
          "const": "hint"
        }
      ]
    }
  }
}