---
source: crates/rustmanifest-report/src/sarif.rs
expression: output
---
{
  "$schema": "https://schemastore.azurewebsites.net/schemas/json/sarif-2.1.0.json",
  "runs": [
    {
      "results": [
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/lib.rs"
                },
                "region": {
                  "byteLength": 15,
                  "byteOffset": 10,
                  "endLine": 1,
                  "startLine": 1
                }
              }
            }
          ],
          "message": {
            "text": "Hardcoded credentials: matched at bytes 10..25"
          },
          "properties": {
            "trace": [
              {
                "fact": "bytes 10..25 in src/lib.rs",
                "reason": "regex of RM-SEC-001 matched"
              }
            ]
          },
          "ruleId": "RM-SEC-001"
        }
      ],
      "tool": {
        "driver": {
          "informationUri": "https://github.com/RAprogramm/RustManifest",
          "name": "rustmanifest",
          "rules": [
            {
              "helpUri": "rustmanifest://methodology/security#creds",
              "id": "RM-SEC-001",
              "name": "RM-SEC-001",
              "shortDescription": {
                "text": "Hardcoded credentials: matched at bytes 10..25"
              }
            }
          ],
          "version": "0.0.0"
        }
      }
    }
  ],
  "version": "2.1.0"
}
